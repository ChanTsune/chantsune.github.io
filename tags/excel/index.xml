 &lt;td style="text-align: center"&gt;4549414003260&lt;/td&gt;
 &lt;td style="text-align: center"&gt;=CONCATENATE(TEXT(B2, &amp;ldquo;0&amp;rdquo;), LEFT(TEXT(C2, &amp;ldquo;0000000000000&amp;rdquo;), 12), TEXT(10 - MOD(SUM(VALUE(MID(C2, 1, 1)), VALUE(MID(C2, 3, 1)), VALUE(MID(C2, 5, 1)), VALUE(MID(C2, 7, 1)), VALUE(MID(C2, 9, 1)), VALUE(MID(C2, 11, 1)))+SUM(B2, VALUE(MID(C2, 2, 1)), VALUE(MID(C2, 4, 1)), VALUE(MID(C2, 6, 1)), VALUE(MID(C2, 8, 1)), VALUE(MID(C2, 10, 1)), VALUE(MID(C2, 12, 1)))*3, 10), &amp;ldquo;0&amp;rdquo;))&lt;/td&gt;
